1006 0 obj
  << /ActualText (3\056 FLIGHT\nManages flight timetables\054 gates\054 and real\055time flight records\056\nflight\137id\240\050INTEGER\054 PK\051 \055 Unique flight record ID\056\nairline\137id\240\050INTEGER\054 FK\051 \055 Foreign key referencing\240AIRLINE\056airline\137id\056\ndeparture\137airport\137id\240\050INTEGER\054 FK\051 \055 Foreign key referencing departure\240AIRPORT\056airport\137id\056\narrival\137airport\137id\240\050INTEGER\054 FK\051 \055 Foreign key referencing arrival\240AIRPORT\056airport\137id\056\ndeparting\137gate\240\050VARCHAR\051 \055 Gate assigned for departure\056\narriving\137gate\240\050VARCHAR\051 \055 Gate assigned for arrival\056\nscheduled\137departure\137time\240\050TIMESTAMP\051 \055 Timetabled departure time\056\nscheduled\137arrival\137time\240\050TIMESTAMP\051 \055 Timetabled arrival time\056\nactual\137departure\137time\240\050TIMESTAMP\051 \055 Actual takeoff timestamp\056\nactual\137arrival\137time\240\050TIMESTAMP\051 \055 Actual landing timestamp\056\ncreated\137at\240\050TIMESTAMP\051 \055 Timestamp of record creation\056\nupdated\137at\240\050TIMESTAMP\051 \055 Timestamp of last update\056\n4\056 PASSENGER\nManages profile details and identity details of travelers\056\npassenger\137id\240\050INTEGER\054 PK\051 \055 Unique passenger profile ID\056\nfirst\137name\240\050VARCHAR\051 \055 Given name of the passenger\056\nlast\137name\240\050VARCHAR\051 \055 Family name of the passenger\056\ngender\240\050VARCHAR\051 \055 Passenger\047s gender\056\ndate\137of\137birth\240\050DATE\051 \055 Date of birth\056\ncountry\137of\137citizenship\240\050VARCHAR\051 \055 Country of legal citizenship\056\ncountry\137of\137residence\240\050VARCHAR\051 \055 Country of legal residence\056\npassport\137number\240\050VARCHAR\054 UK\051 \055 Unique passport identification number\056\ncreated\137at\240\050TIMESTAMP\051 \055 Timestamp of profile creation\056\nupdated\137at\240\050TIMESTAMP\051 \055 Timestamp of last update\056)
